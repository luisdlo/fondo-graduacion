# Caddy detrás del dominio fondo-ingles.ddns.net (No-IP).
# Caddy escucha 80 y 443, saca cert de Let's Encrypt automático y renueva solo.
# El puerto 443 ya está publicado en docker-compose.yml.

fondo-ingles.ddns.net {
    # -----------------------------------------------------------------
    # Dozzle bajo /logs con basic auth.
    # Para cambiar el password, genera un hash nuevo:
    #   docker run --rm caddy caddy hash-password --plaintext "TU_PASSWORD"
    # y reemplaza el hash de "admin ..." de abajo con la salida.
    # -----------------------------------------------------------------
    handle /logs* {
        basicauth {
            admin $2a$14$2n.OKNNrsnNKmpBROGnMMOcA9GGo1lMywmBlXjmX8JEQWOe7AiGvq
        }
        reverse_proxy dozzle:8080
    }

    # Consola H2 bajo /h2 con basic auth (mismo hash que Dozzle).
    # OJO: la consola da acceso completo a la BD. Nunca la dejes sin auth.
    handle /h2* {
        basicauth {
            admin $2a$14$2n.OKNNrsnNKmpBROGnMMOcA9GGo1lMywmBlXjmX8JEQWOe7AiGvq
        }
        reverse_proxy app:8080
    }

    # App Spring Boot en la raíz
    handle {
        reverse_proxy app:8080
    }

    # Logs en formato JSON para que Dozzle los muestre bonitos
    log {
        output stdout
        format json
    }
}
