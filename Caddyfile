# Caddy escuchando en el puerto 80 del VPS.
# Cuando tengas dominio, cambia ":80" por "fondo.tudominio.mx" y Caddy
# saca certificado HTTPS automáticamente (necesitas abrir el puerto 443
# en el docker-compose y en el firewall del VPS).

:80 {
    # -----------------------------------------------------------------
    # Dozzle bajo /logs con contraseña.
    # Genera el hash una vez con:
    #   docker run --rm caddy caddy hash-password --plaintext "TU_PASSWORD"
    # y reemplaza la línea de "admin ..." de abajo con la salida.
    # -----------------------------------------------------------------
    handle /logs* {
        basicauth {
            admin $2a$14$PONER_AQUI_HASH_GENERADO_CON_CADDY_HASH_PASSWORD
        }
        reverse_proxy dozzle:8080
    }

    # Consola H2 bajo /h2 con basic auth (mismo usuario/password que Dozzle).
    # OJO: la consola da acceso completo a la BD. Nunca la dejes sin auth.
    handle /h2* {
        basicauth {
            admin $2a$14$PONER_AQUI_HASH_GENERADO_CON_CADDY_HASH_PASSWORD
        }
        reverse_proxy app:8080
    }

    # App Spring Boot en la raíz
    handle {
        reverse_proxy app:8080
    }

    # Logs en formato JSON para que Dozzle los muestre bonitos
    log {
        output stdout
        format json
    }
}
